# Copy to .env for local overrides. Values are shell-sourced by config.sh.

ENABLE_OLLAMA=${ENABLE_OLLAMA:-false}
ENABLE_CODEX=${ENABLE_CODEX:-true}
ENABLE_MODEL_COMPARISON=${ENABLE_MODEL_COMPARISON:-true}

OLLAMA_URL=${OLLAMA_URL:-http://localhost:11434}
OLLAMA_MODEL=${OLLAMA_MODEL:-llama3.1}
OLLAMA_API_KEY=${OLLAMA_API_KEY:-}
OLLAMA_TIMEOUT_SECONDS=${OLLAMA_TIMEOUT_SECONDS:-300}
OLLAMA_CHUNK_CHARS=${OLLAMA_CHUNK_CHARS:-3500}
OLLAMA_NUM_CTX=${OLLAMA_NUM_CTX:-8192}
OLLAMA_MERGE_CHUNKS=${OLLAMA_MERGE_CHUNKS:-true}

CODEX_TIMEOUT_SECONDS=${CODEX_TIMEOUT_SECONDS:-600}
CODEX_LLM_MODEL=${CODEX_LLM_MODEL:-gpt-5.4-mini}
CODEX_LLM_SANDBOX=${CODEX_LLM_SANDBOX:-read_only}
CODEX_LLM_EPHEMERAL=${CODEX_LLM_EPHEMERAL:-true}
CODEX_LLM_BASE_INSTRUCTIONS=${CODEX_LLM_BASE_INSTRUCTIONS:-}

SEND_TELEGRAM=${SEND_TELEGRAM:-false}
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID:-}
TELEGRAM_TOPIC_ID=${TELEGRAM_TOPIC_ID:-}
TELEGRAM_CONFIG=${TELEGRAM_CONFIG:-}
TELEGRAM_TIMEOUT_SECONDS=${TELEGRAM_TIMEOUT_SECONDS:-30}
TELEGRAM_ASSUME_SENT_ON_TIMEOUT=${TELEGRAM_ASSUME_SENT_ON_TIMEOUT:-true}
WATCHLIST_DRY_RUN=${WATCHLIST_DRY_RUN:-false}
SEND_WHATSAPP=${SEND_WHATSAPP:-false}
WHATSAPP_DIGEST_JID=${WHATSAPP_DIGEST_JID:-}
WHATSAPP_SEND_API=${WHATSAPP_SEND_API:-http://localhost:3000/send-message}
WHATSAPP_SEND_TOKEN=${WHATSAPP_SEND_TOKEN:-}
WHATSAPP_MEDIA_BASE_URL=${WHATSAPP_MEDIA_BASE_URL:-http://localhost:3000}
WHATSAPP_MEDIA_TOKEN=${WHATSAPP_MEDIA_TOKEN:-}
WHATSAPP_TIMEOUT_SECONDS=${WHATSAPP_TIMEOUT_SECONDS:-30}
WHATSAPP_MAX_LEN=${WHATSAPP_MAX_LEN:-3500}
IMAGE_ANALYSIS_CONCURRENCY=${IMAGE_ANALYSIS_CONCURRENCY:-1}
IMAGE_ANALYSIS_MAX_DIMENSION=${IMAGE_ANALYSIS_MAX_DIMENSION:-1024}
IMAGE_ANALYSIS_PREVIEW_DIMENSION=${IMAGE_ANALYSIS_PREVIEW_DIMENSION:-512}
IMAGE_ANALYSIS_BLUR_BLURRY=${IMAGE_ANALYSIS_BLUR_BLURRY:-80}
IMAGE_ANALYSIS_BLUR_SLIGHTLY_BLURRY=${IMAGE_ANALYSIS_BLUR_SLIGHTLY_BLURRY:-180}
IMAGE_ANALYSIS_DUPLICATE_HASH_DISTANCE=${IMAGE_ANALYSIS_DUPLICATE_HASH_DISTANCE:-4}
IMAGE_ANALYSIS_SIMILAR_HASH_DISTANCE=${IMAGE_ANALYSIS_SIMILAR_HASH_DISTANCE:-6}
IMAGE_ANALYSIS_HEAVY_BLOCKINESS=${IMAGE_ANALYSIS_HEAVY_BLOCKINESS:-9}
DSPY_PROMPT_MODE=${DSPY_PROMPT_MODE:-auto}
DSPY_LM_MODEL=${DSPY_LM_MODEL:-}
CONTEXT_MESSAGES_PER_GROUP=${CONTEXT_MESSAGES_PER_GROUP:-0}
REGULAR_MESSAGES_PER_GROUP=${REGULAR_MESSAGES_PER_GROUP:-0}
NEWSLETTER_MESSAGES_PER_GROUP=${NEWSLETTER_MESSAGES_PER_GROUP:-0}
DIGEST_EXCLUDED_GROUP_IDS=${DIGEST_EXCLUDED_GROUP_IDS:-}
DIGEST_MESSAGE_CHAR_LIMIT=${DIGEST_MESSAGE_CHAR_LIMIT:-0}
CONTEXT_MESSAGE_CHAR_LIMIT=${CONTEXT_MESSAGE_CHAR_LIMIT:-0}

PROMETHEUS_METRICS_ENABLED=${PROMETHEUS_METRICS_ENABLED:-false}
PROMETHEUS_METRICS_FILE=${PROMETHEUS_METRICS_FILE:-data/metrics/whatsapp_digest.prom}
PROMETHEUS_METRICS_PUSH_URL=${PROMETHEUS_METRICS_PUSH_URL:-}
PROMETHEUS_METRICS_USERNAME=${PROMETHEUS_METRICS_USERNAME:-}
PROMETHEUS_METRICS_PASSWORD=${PROMETHEUS_METRICS_PASSWORD:-}
PROMETHEUS_METRICS_JOB=${PROMETHEUS_METRICS_JOB:-whatsapp_digest}
PROMETHEUS_METRICS_INSTANCE=${PROMETHEUS_METRICS_INSTANCE:-}
PROMETHEUS_METRICS_TIMEOUT_SECONDS=${PROMETHEUS_METRICS_TIMEOUT_SECONDS:-10}

BACKUP_PROMETHEUS_METRICS_ENABLED=${BACKUP_PROMETHEUS_METRICS_ENABLED:-false}
BACKUP_PROMETHEUS_METRICS_FILE=${BACKUP_PROMETHEUS_METRICS_FILE:-data/metrics/whatsapp_backup.prom}
BACKUP_PROMETHEUS_METRICS_PUSH_URL=${BACKUP_PROMETHEUS_METRICS_PUSH_URL:-}
BACKUP_PROMETHEUS_METRICS_USERNAME=${BACKUP_PROMETHEUS_METRICS_USERNAME:-}
BACKUP_PROMETHEUS_METRICS_PASSWORD=${BACKUP_PROMETHEUS_METRICS_PASSWORD:-}
BACKUP_PROMETHEUS_METRICS_JOB=${BACKUP_PROMETHEUS_METRICS_JOB:-whatsapp_backup}
BACKUP_PROMETHEUS_METRICS_INSTANCE=${BACKUP_PROMETHEUS_METRICS_INSTANCE:-}
BACKUP_PROMETHEUS_METRICS_TIMEOUT_SECONDS=${BACKUP_PROMETHEUS_METRICS_TIMEOUT_SECONDS:-10}
