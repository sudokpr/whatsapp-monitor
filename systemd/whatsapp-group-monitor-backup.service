[Unit]
Description=Back up WhatsApp group monitor data to DietPi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/kp/workspace/projects/whatsapp-group-monitor
ExecStart=/home/kp/workspace/projects/whatsapp-group-monitor/scripts/backup_to_dietpi.sh
